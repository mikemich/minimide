{
  "name": "minimide",
  "productName": "Minimide",
  "version": "0.1.0",
  "description": "A small, beautiful, hackable editor.",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron . --dev",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac -c.mac.identity=-",
    "dist:dir": "node build.mjs && electron-builder --dir",
    "icon": "electron scripts/make-icon.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0"
  },
  "author": "Minimide contributors",
  "build": {
    "appId": "dev.minimide.app",
    "productName": "Minimide",
    "copyright": "Copyright \u00a9 2026 Minimide contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/main/**",
      "src/preload/**",
      "dist/renderer/**",
      "!dist/renderer/**/*.map",
      "packages/**",
      "docs/PLUGINS.md"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": [
          "js",
          "mjs",
          "cjs",
          "jsx",
          "ts",
          "tsx",
          "json",
          "md",
          "markdown",
          "txt",
          "css",
          "scss",
          "less",
          "html",
          "htm",
          "xml",
          "yml",
          "yaml",
          "toml",
          "ini",
          "py",
          "rb",
          "rs",
          "go",
          "c",
          "h",
          "cc",
          "cpp",
          "hpp",
          "java",
          "kt",
          "swift",
          "php",
          "lua",
          "sh",
          "zsh",
          "bash",
          "sql",
          "vue",
          "svelte",
          "zig"
        ],
        "name": "Source Code",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Minimide ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "minimide"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
