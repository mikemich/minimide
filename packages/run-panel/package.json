{
  "name": "run-panel",
  "displayName": "Run Panel",
  "description": "Run shell commands in the project and click file:line output to jump there.",
  "version": "0.1.0",
  "main": "index.js",
  "styles": ["style.css"],
  "keymap": { "Mod-Shift-r": "run-panel:focus", "Mod-Alt-r": "run-panel:rerun" },
  "configSchema": {
    "maxLines": { "type": "number", "default": 5000, "title": "Scrollback Lines" }
  }
}
